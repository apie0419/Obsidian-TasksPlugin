filters:
  and:
    - note.tags.contains("task")
    - file.path.startsWith("TaskManagement/Tasks/")
formulas:
  priorityWeight: if(note.priority == "high", 3, if(note.priority == "medium", 2, if(note.priority == "low", 1, 0)))
  isOverdue: note.due && date(note.due) < today() && note.status != "done"
  daysUntilDue: if(note.due, ((number(date(note.due)) - number(today())) / 86400000).floor(), null)
views:
  - type: frontmatterkanban
    name: Kanban Board
    groupBy:
      property: status
      direction: ASC
    order:
      - status
      - project
      - feature
      - priority
      - formula.priorityWeight
      - due
      - work_start
      - work_end
      - completed
      - file.name
    sort:
      - property: formula.priorityWeight
        direction: DESC
      - property: due
        direction: ASC
    options:
      columnWidth: 380
  - type: frontmattertimeline
    name: Timeline
    order:
      - status
      - project
      - feature
      - priority
      - formula.priorityWeight
      - due
      - work_start
      - work_end
      - completed
      - file.name
    sort:
      - property: formula.daysUntilDue
        direction: ASC
      - property: formula.priorityWeight
        direction: DESC
    options:
      dayWidth: 150
      laneHeight: 118
      hideWeekends: false
    hideWeekends: false
